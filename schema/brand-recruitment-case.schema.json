{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/schema/brand-recruitment-case.schema.json",
  "title": "Brand Recruitment Benchmark Case",
  "type": "object",
  "required": [
    "id", "slug", "title", "asset", "assetMeta", "source", "rights",
    "brandShown", "brandRecognition", "officialStatus", "authenticityNote",
    "brandCategory", "layoutFamily", "compositionDensity", "designEngine",
    "reusableElements", "nonReusableIdentityAssets", "layoutZones",
    "whyItWorks", "riskNotes", "tags"
  ],
  "properties": {
    "id": { "type": "string", "pattern": "^R[0-9]{3}$" },
    "slug": { "type": "string", "pattern": "^[a-z0-9-]+$" },
    "brandShown": { "type": "string", "minLength": 1 },
    "brandRecognition": { "enum": ["global", "national", "regional", "unknown"] },
    "officialStatus": { "const": "unverified" },
    "authenticityNote": { "type": "string", "minLength": 8 },
    "campaignSeriesId": { "type": ["string", "null"] },
    "rights": {
      "type": "object",
      "required": ["status", "commercialReuseVerified"],
      "properties": {
        "status": { "const": "reference-only" },
        "commercialReuseVerified": { "const": false }
      }
    },
    "nonReusableIdentityAssets": {
      "type": "array", "minItems": 1, "items": { "type": "string" }
    },
    "layoutZones": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "prefixItems": [
          { "type": "number", "minimum": 0, "maximum": 1 },
          { "type": "number", "minimum": 0, "maximum": 1 },
          { "type": "number", "minimum": 0, "maximum": 1 },
          { "type": "number", "minimum": 0, "maximum": 1 }
        ],
        "items": false
      }
    }
  },
  "additionalProperties": true
}
